{
  "file": "CLOCKS.AD",
  "module": "clocks",
  "description": "Graphics Module Library",
  "imports": [
    "KERNEL",
    "GDI",
    "USER",
    "SOUND"
  ],
  "nametable": {
    "2:#1": "MODERN",
    "2:#2": "ANTIQUE",
    "2:#3": "BWMODERN",
    "2:#4": "BWANTIQU",
    "2:#5": "ZERO",
    "2:#6": "ONE",
    "2:#7": "TWO",
    "2:#8": "THREE",
    "2:#9": "FOUR",
    "2:#10": "FIVE",
    "2:#11": "SIX",
    "2:#12": "SEVEN",
    "2:#13": "EIGHT",
    "2:#14": "NINE"
  },
  "controls": {
    "#1": {
      "type": 3,
      "title": "Type:",
      "count": 3,
      "default_value": 2,
      "choices": [
        "Modern",
        "Antique",
        "Digital"
      ]
    },
    "#2": {
      "type": 1,
      "title": "Float Speed:",
      "count": 5,
      "default_value": 50,
      "labels": [
        "Slowest",
        "Slow",
        "Medium",
        "Fast",
        "Fastest"
      ],
      "thresholds": [
        20,
        40,
        60,
        80,
        100
      ]
    },
    "#3": {
      "type": 5,
      "title": "Show Seconds",
      "count": 0,
      "default_value": 1
    },
    "#4": {
      "type": 5,
      "title": "Sound",
      "count": 0,
      "default_value": 0
    }
  },
  "strings": {
    "#10": "Clocks by Bill Stewart & Jim Stewart.\r\n  \u00a91990 Berkeley Systems Inc.",
    "#20": "Clocks",
    "#30": "CLOCKS (tm)\r\n\r\nBased on Clock by Rob Vaterlaus.\r\n\r\nYou can choose from 3 different styles of clocks with the \"Type\" drop-down list box.\r\n\r\nThe \"Float Speed\" slider controls the speed that the clock moves around the screen.\r\n\r\nCheck \"Show Seconds\" to display the seconds.  \r\n\r\nTo hear the clock ticking, check the \"Sound\" check box."
  },
